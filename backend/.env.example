# ==============================================================================
# Shelfy.ai Backend Configuration Template (Local / Cloud Run)
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
# Comma-separated list of origins. In production, provide your Vercel or custom domain
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,*

# Google Gemini / LLM API Key (Required for Title-Author Cleanup and Top 3 Recommendations)
LLM_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Books API Key (Optional: enhances edition lookup and high-res cover retrieval)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Model Path (relative to /backend or absolute in container)
YOLO_MODEL_PATH=models/best.pt

# Supabase Auth & Storage (Optional: required for cloud library persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
